#!/bin/bash

# Install bgutil at runtime if not already present
if [ ! -d "/app/bgutil-ytdlp-pot-provider" ]; then
    echo "Installing bgutil PO token provider..."
    git clone --single-branch --branch 1.3.1 \
        https://github.com/Brainicism/bgutil-ytdlp-pot-provider.git \
        /app/bgutil-ytdlp-pot-provider
    cd /app/bgutil-ytdlp-pot-provider/server
    deno install --allow-scripts=npm:canvas --frozen
    cd /app
fi

# Start bgutil HTTP server in background
echo "Starting bgutil server on port 4416..."
cd /app/bgutil-ytdlp-pot-provider/server
cd node_modules && deno run --allow-env --allow-net --allow-ffi=. --allow-read=. ../src/main.ts &
cd /app
sleep 5

# Start the bot
uv run python3 -m anony
